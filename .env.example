# Copy to .env (gitignored). Corpus generation uses OpenAI; the screener judge and the
# second utility column use Anthropic.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional proxy settings
# SOCAREGUARD_DEFAULT_MODEL=openai/gpt-4.1-mini
# SOCAREGUARD_MODELS=openai/gpt-4.1-mini,anthropic/claude-sonnet-5
# SOCAREGUARD_VAULT=vault/socareguard.sqlite      # SOCAREGUARD_VAULT_KEY=<base64 32 bytes> overrides the key file
# SOCAREGUARD_LEDGER=vault/ledger.jsonl
# SOCAREGUARD_GLINER=auto | gliner2 | gliner1
# SOCAREGUARD_JUDGE_MODEL=openai/gpt-4.1          # clause-grounded conduct judge; SOCAREGUARD_SCREEN=off disables the screen
# SOCAREGUARD_TRANSFER_BASIS="..."                 # the agency's own transfer-basis statement, written to every ledger row
# SOCAREGUARD_API_KEYS=...                         # client keys; with keys set, ledger actors are attested
# SOCAREGUARD_SUPERVISOR_KEYS=...                  # keys allowed to release a withheld draft
# SOCAREGUARD_RETENTION_HOURS=720                  # docker-compose.yml sets 720 (30 days); 0 keeps sessions until DELETE and logs a WARNING
